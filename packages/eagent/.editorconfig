root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,js,mjs,json,yml,yaml,md}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks, so don't trim them.
[*.md]
trim_trailing_whitespace = false
