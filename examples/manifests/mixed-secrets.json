{
  "name": "mixed-secrets",
  "stage": "prod",
  "release": "2.1.0",
  "image": "registry.internal/b2:2.1.0",
  "pullPolicy": "IfNotPresent",
  "user": "app",
  "workdir": "/srv/app",
  "ports": [
    8080
  ],
  "healthcheck": {
    "httpGet": {
      "path": "/healthz",
      "port": 8080
    }
  },
  "env": {
    "A_PASSWORD": "plain-a",
    "B_TOKEN": {
      "secretRef": "b-token"
    }
  },
  "secrets": []
}
