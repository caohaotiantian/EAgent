{
  "name": "eagent",
  "version": "0.1.0",
  "description": "A minimalist AI agent with a tiny stable core and Emacs-grade extensibility. Everything is a hot-reloadable extension.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "eagent": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/kernel/index.js",
    "./providers/mock": "./dist/providers/mock.js",
    "./providers/anthropic": "./dist/providers/anthropic.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "node --import tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
