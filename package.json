{
  "name": "loom-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loom \u2014 graph-native multi-agent collaboration and orchestration framework",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --force --pretty && tsc -p packages/core/tsconfig.test.json --pretty",
    "typecheck:fast": "tsc -b --pretty && tsc -p packages/core/tsconfig.test.json --pretty",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/*/test/**/*.test.ts\"",
    "build": "tsc -b --force",
    "check": "npm run typecheck && npm test && node scripts/check-zero-dep.mjs && node scripts/check-surface.mjs && node scripts/check-kernel.mjs",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "loom": "node packages/core/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.0"
  }
}
