{
  "name": "eagent",
  "version": "0.1.0",
  "description": "A minimalist AI agent with a tiny stable core and Emacs-grade extensibility. Everything is a hot-reloadable extension.",
  "type": "module",
  "license": "MIT",
  "author": "caohaotiantian",
  "keywords": [
    "agent",
    "llm",
    "ai",
    "extensible",
    "emacs",
    "mcp",
    "anthropic",
    "tools",
    "kernel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caohaotiantian/eagent.git"
  },
  "homepage": "https://github.com/caohaotiantian/eagent#readme",
  "bugs": {
    "url": "https://github.com/caohaotiantian/eagent/issues"
  },
  "bin": {
    "eagent": "./dist/cli.js",
    "eagent-serve": "./dist/server.js"
  },
  "exports": {
    ".": "./dist/kernel/index.js",
    "./host": "./dist/host.js",
    "./server": "./dist/server.js",
    "./providers/mock": "./dist/providers/mock.js",
    "./providers/anthropic": "./dist/providers/anthropic.js",
    "./providers/openai": "./dist/providers/openai.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "dev": "node --import tsx src/cli.ts",
    "serve": "node --import tsx src/server.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
