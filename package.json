{
  "name": "eagent",
  "version": "0.2.0",
  "description": "A minimalist AI agent with a tiny stable core and Emacs-grade extensibility. Everything is a hot-reloadable extension.",
  "type": "module",
  "license": "MIT",
  "author": "caohaotiantian",
  "keywords": [
    "agent",
    "llm",
    "ai",
    "extensible",
    "emacs",
    "mcp",
    "anthropic",
    "openai",
    "gemini",
    "tools",
    "kernel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caohaotiantian/eagent.git"
  },
  "homepage": "https://github.com/caohaotiantian/eagent#readme",
  "bugs": {
    "url": "https://github.com/caohaotiantian/eagent/issues"
  },
  "bin": {
    "eagent": "./dist/cli.js",
    "eagent-serve": "./dist/server.js",
    "eagent-tui": "./dist/tui/main.js"
  },
  "main": "./dist/kernel/index.js",
  "types": "./dist/kernel/index.d.ts",
  "exports": {
    ".": "./dist/kernel/index.js",
    "./host": "./dist/host.js",
    "./server": "./dist/server.js",
    "./providers/mock": "./dist/providers/mock.js",
    "./providers/anthropic": "./dist/providers/anthropic.js",
    "./providers/openai": "./dist/providers/openai.js",
    "./providers/gemini": "./dist/providers/gemini.js",
    "./providers/cassette": "./dist/providers/cassette.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "node scripts/build-binary.mjs",
    "build:tui": "npx --yes esbuild src/tui/main.tsx --bundle --platform=node --format=esm --target=node22 --jsx=automatic --alias:react-devtools-core=./src/tui/devtools-stub.js --banner:js='import{createRequire as __cr}from\"module\";const require=__cr(import.meta.url);' --outfile=dist/tui/bundle.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "test:tui": "node --import tsx --test \"test/tui/**/*.test.tsx\"",
    "eval": "node --import tsx src/eval-runner.ts evals",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "dev": "node --import tsx src/cli.ts",
    "serve": "node --import tsx src/server.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "6.8.0",
    "jiti": "^2.4.2",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "19.2.17",
    "ink-testing-library": "4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
