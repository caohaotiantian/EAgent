{
  "name": "eagent",
  "version": "0.2.0",
  "description": "EAgent — a minimalist AI agent with a tiny stable core and Emacs-grade extensibility.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "eagent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --prefix .. run build",
    "test": "node --import tsx --test \"src/**/*.test.ts?(x)\"",
    "dev": "node --import tsx src/cli.tsx"
  },
  "dependencies": {
    "@eagent/core": "file:..",
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
