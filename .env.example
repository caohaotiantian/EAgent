# EAgent environment configuration — copy to `.env` and fill in.
#
# The CLI (`eagent`) and server (`eagent-serve`) auto-load `.env` at startup.
# Values already present in the real environment always take precedence, so
# `.env` is a convenience for local development, not an override.
#
# With no provider key set, EAgent runs the deterministic offline mock.

# --- Anthropic (the default provider when configured) ---------------------
# ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN both work (sent as x-api-key).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com      # or an Anthropic-compatible proxy
# ANTHROPIC_MODEL=claude-fable-5                     # used unless you pass --model

# --- OpenAI / OpenAI-compatible (vLLM, Ollama, GLM gateways, ...) ----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS_PARAM=max_tokens                 # set max_completion_tokens for newer OpenAI models

# --- Google Gemini --------------------------------------------------------
# GEMINI_API_KEY=...                                 # or GOOGLE_API_KEY
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# --- HTTP server (eagent-serve) -------------------------------------------
# EAGENT_TOKEN=change-me        # require `Authorization: Bearer <token>` on /run & DELETE /sessions
# EAGENT_HOST=127.0.0.1         # bind address; set 0.0.0.0 to expose (only with a token!)
# PORT=8787

# --- Misc -----------------------------------------------------------------
# EAGENT_WORKSPACE=.                                 # root the fs tools are confined to
# EAGENT_JOURNAL=~/.eagent/journal.jsonl             # enable durable run journaling
# EAGENT_MCP_SERVERS=[]                              # JSON array of MCP server configs
# EAGENT_THINKING=off                                # default reasoning level: off | low | medium | high (overridden by --think)
# EAGENT_SKILLS_DIR=~/.eagent/skills                 # where the skills extension looks for SKILL.md folders
# EAGENT_PACKAGES_DIR=~/.eagent/packages             # where /pkg-add installs and loads extension packages
# EAGENT_MICROAGENTS_DIR=.eagent/microagents         # directory of trigger-tagged *.md microagent knowledge files

# --- In-repo agent library (see library/README.md) -----------------------
# `library/` is the opt-in official library — NOT auto-loaded. Each resource kind
# instead layers ~/.eagent/<kind> (home) + <cwd>/.eagent/<kind> (project), project
# wins. Opt in by copying library/<kind>/* into a tier, OR set a <kind>.dir below
# to read the library single-source (that dir replaces the layered pair). Use
# absolute paths when running from a different directory.
# EAGENT_TEMPLATES_DIR=./library/templates            # agent recipes (personas)
# EAGENT_TEAMS_DIR=./library/teams                    # multi-agent crews
# EAGENT_MICROAGENTS_DIR=./library/microagents        # (overrides the default above)
# EAGENT_SKILLS_DIR=./library/skills                  # (overrides the default above)

# --- Extension kill switches (set to "off" to disable; any other value/unset = default) ---
# These guards/transforms are ON by default unless noted; "off" is the only value that disables.
# EAGENT_PRUNE=off               # disable token-budget pruning of old oversized tool outputs (default: on)
# EAGENT_RECOVERY=off            # disable corrective hints appended to failed tool results (default: on)
# EAGENT_WRITE_GUARD=off         # disable the prompt before overwriting an unread existing file (default: on)
# EAGENT_MICROAGENTS=off         # disable trigger-based microagent knowledge injection (default: on)
# EAGENT_FLOW_GUARD=off          # disable the taint-then-hold-egress gate (default: on, ask mode)
# EAGENT_BASH_POLICY=off         # disable the shell command policy gate (loaded but a no-op until rules are set)
# EAGENT_TOOL_SPILL=off          # don't spill oversized tool output to .eagent/tool-output; clip in-context (default: spill)
# EAGENT_RISK_GUARD=off          # force-disable the LLM risk analyzer (off by default; enable via /risk-guard on)
# EAGENT_WATCHDOG=off            # disable the idle-deadline watchdog on the main provider stream (default: on)

# --- Hardened profile -----------------------------------------------------
# One switch for a defense-in-depth server posture: enables the enforcing guards
# (risk-guard + provenance + content-guard local fencing) and confines the shell
# to a workspace-write sandbox tier. Off by default; a real env value wins over
# the file key, and the profile is fail-secure. (Programmatic hosts can instead
# pass `createAgentHost({ hardened: true })`.)
# EAGENT_HARDENED=true

# --- Resource & safety limits (numeric knobs; each resolves override > env > file > default) ---
# All are optional; defaults are production-sane. Set to tighten (or loosen) a
# deployment. Byte caps are in bytes; timeouts/deadlines in milliseconds.
# EAGENT_SUBAGENTS_MAX_FANOUT=16                 # max concurrent sub-agents a single spawn may fan out to
# EAGENT_WATCHDOG_IDLE_MS=120000                 # abort the main provider stream after this idle gap (watchdog)
# EAGENT_MCP_REQUEST_TIMEOUT_MS=60000            # per MCP tool call
# EAGENT_RISK_GUARD_TIMEOUT_MS=10000             # the risk analyzer's own LLM call
# EAGENT_MAX_SESSIONS=1000                        # server per-session LRU cap (0 disables the cap)
# EAGENT_FS_MAX_READ_BYTES=16777216              # cap on a single file read (read/edit/grep/search) — 16 MiB
# EAGENT_MAX_MCP_READ_BYTES=16777216             # cap on an MCP resource read — 16 MiB
# EAGENT_PROVIDERS_ANTHROPIC_MAX_TOKENS=8192     # per-request output-token cap (Anthropic; default 8192)
# EAGENT_PROVIDERS_OPENAI_MAX_TOKENS=8192        # per-request output-token cap (OpenAI; default 8192)
# EAGENT_PROVIDERS_GEMINI_MAX_TOKENS=8192        # per-request output-token cap (Gemini; default 8192)
#
# Bounded nested LLM sub-calls: every extension that makes its own model call has a
# timeout knob EAGENT_<EXT>_SUB_CALL_TIMEOUT_MS (default 30000). The <EXT>s are:
# compact, drift-probe, evals, goal, handoff, reasoning-search, routing, session.
# EAGENT_COMPACT_SUB_CALL_TIMEOUT_MS=30000       # e.g. the compaction summarizer's call
